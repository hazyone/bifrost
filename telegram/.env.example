# Telegram Client Configuration
# ==============================

# Phone number with country code (REQUIRED)
PHONE_NUMBER=+79991234567

# Session file name
SESSION_NAME=telegram_session

# Target group (optional, can specify at runtime)
TARGET_GROUP=@your_group

# ==============================
# Client Type (choose one)
# ==============================
# Options: tdesktop, android, ios, macos, web, custom
#
# Each uses REAL credentials from official clients:
#   tdesktop  - Telegram Desktop (api_id=2040)
#   android   - Telegram for Android (api_id=6)
#   ios       - Telegram for iOS (api_id=10840)
#   macos     - Telegram for macOS (api_id=2834)
#   web       - Telegram Web (api_id=2496)
#   custom    - Your own API_ID/API_HASH
#
CLIENT_TYPE=tdesktop

# ==============================
# Custom credentials (only if CLIENT_TYPE=custom)
# ==============================
# Get your own at: https://my.telegram.org/apps
# API_ID=your_api_id
# API_HASH=your_api_hash
# DEVICE_MODEL=Desktop
# SYSTEM_VERSION=Windows 10
# APP_VERSION=5.8.3 x64
# LANG_CODE=en
# SYSTEM_LANG_CODE=en-US

# ==============================
# Device randomization
# ==============================
# Set to "true" to randomize device model (useful for multiple sessions)
# RANDOMIZE_DEVICE=false

# ==============================
# Rate limiting (be respectful!)
# ==============================
# Delay between API calls in seconds
FETCH_DELAY=1.0

# Messages per batch (max 100)
BATCH_SIZE=100

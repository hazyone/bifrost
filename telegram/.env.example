# Telegram API credentials
# Get your own at https://my.telegram.org/apps
#
# Or use TDesktop credentials (appear as official client):
# API_ID=611335
# API_HASH=d524b414d21f4d37f08684c1df41ac9c

API_ID=your_api_id
API_HASH=your_api_hash

# Phone number with country code (e.g., +79991234567)
PHONE_NUMBER=+your_phone_number

# Session file name (will be created after first auth)
SESSION_NAME=telegram_session

# Optional: target group/channel username or invite link
TARGET_GROUP=@your_group_or_channel

# Rate limiting settings (be respectful to Telegram servers)
# Delay between message fetches in seconds
FETCH_DELAY=1.0
# Maximum messages per batch
BATCH_SIZE=100
